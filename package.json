    "check:ui": "node scripts/check-ui.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "@kyralabs/m3e-tokens": "1.8.0",
    "@kyralabs/m3exp-web": "1.8.0"
  }
}
